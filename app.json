{
  "expo": {
    "name": "myWik",
    "slug": "mywik",
    "scheme": "mywik",
    "version": "0.4.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.mywik.app",
      "buildNumber": "4"
    },
    "android": {
      "package": "de.mywik.app",
      "versionCode": 4,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "myWik",
      "shortName": "myWik",
      "themeColor": "#080b0d",
      "backgroundColor": "#080b0d"
    },
    "plugins": [
      "expo-notifications",
      "expo-status-bar"
    ]
  }
}
