{
  "expo": {
    "name": "myWik",
    "slug": "mywik",
    "scheme": "mywik",
    "version": "0.8.1",
    "icon": "./assets/app-icon-tortoise-a.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.mywik.app",
      "buildNumber": "9"
    },
    "android": {
      "package": "de.mywik.app",
      "versionCode": 9,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-tortoise-a.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "myWik",
      "shortName": "myWik",
      "favicon": "./assets/app-icon-tortoise-a.png",
      "themeColor": "#080b0d",
      "backgroundColor": "#080b0d"
    },
    "plugins": [
      "expo-notifications",
      "expo-status-bar"
    ]
  }
}
