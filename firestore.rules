rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function own(uid) { return request.auth != null && request.auth.uid == uid; }
    function validEntity() {
      let d = request.resource.data;
      return d.keys().hasAll(['kind', 'entityId', 'value', 'updatedAt', 'revision', 'deleted'])
        && d.keys().hasOnly(['kind', 'entityId', 'value', 'updatedAt', 'revision', 'deleted'])
        && d.kind in ['progress', 'note', 'card', 'session', 'visit', 'later', 'recommendation', 'settings']
        && d.entityId is string && d.entityId.size() > 0 && d.entityId.size() <= 250
        && d.revision is string && d.revision.size() > 0 && d.revision.size() <= 150
        && d.updatedAt is number && d.updatedAt >= 0
        && d.deleted is bool
        && (d.deleted ? d.value == null : validValue(d));
    }
    function validValue(d) {
      return (d.kind == 'visit' && d.value is string && d.value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        || (d.kind == 'settings' && d.value is map && d.value.theme in ['system', 'light', 'dark'] && d.value.reminders is map)
        || (d.kind == 'progress' && d.value is map && d.value.articleId is string && d.value.status in ['open', 'unclear', 'working', 'done'] && d.value.starred is bool && d.value.history is list && d.value.history.size() <= 200)
        || (d.kind == 'note' && d.value is map && d.value.id is string && d.value.articleId is string && d.value.text is string && d.value.text.size() <= 20000 && d.value.kind in ['personal', 'improvement'])
        || (d.kind == 'card' && d.value is map && d.value.id is string && d.value.subjectId is string && d.value.front is string && d.value.front.size() <= 10000 && d.value.back is string && d.value.back.size() <= 20000)
        || (d.kind == 'session' && d.value is map && d.value.id is string && d.value.subjectId is string && d.value.kind in ['article', 'cards'] && d.value.seconds is number && d.value.seconds >= 0 && d.value.seconds <= 86400 && d.value.day is string)
        || (d.kind == 'later' && d.value is map && d.value.id is string && d.value.subjectId is string && d.value.question is string && d.value.question.size() <= 20000 && d.value.answer is string && d.value.answer.size() <= 30000 && d.value.status in ['open', 'done'])
        || (d.kind == 'recommendation' && d.value is map && d.value.id is string && d.value.articleId is string && d.value.state in ['open', 'done', 'dismissed', 'snoozed']);
    }
    match /users/{uid}/entities/{entityId} {
      allow read: if own(uid);
      allow create: if own(uid) && validEntity();
      allow update: if own(uid) && validEntity()
        && request.resource.data.kind == resource.data.kind
        && request.resource.data.entityId == resource.data.entityId;
      // Sync clients write tombstones so offline devices cannot resurrect deletions.
      allow delete: if false;
    }
    match /catalog/{id} { allow read: if true; allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
