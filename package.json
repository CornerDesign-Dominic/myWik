{
  "name": "mywik",
  "version": "0.11.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node node_modules/@playwright/test/cli.js test",
    "export:web": "expo export --platform web",
    "export:native": "expo export --platform android --platform ios --output-dir dist-native",
    "check": "npm run typecheck && npm test && npm run export:web",
    "build:catalogue": "node --import tsx scripts/build-catalogue.ts",
    "prestart": "npm run build:catalogue",
    "preandroid": "npm run build:catalogue",
    "preios": "npm run build:catalogue",
    "preweb": "npm run build:catalogue",
    "pretypecheck": "npm run build:catalogue",
    "pretest": "npm run build:catalogue",
    "preexport:web": "npm run build:catalogue",
    "preexport:native": "npm run build:catalogue",
    "eas-build-post-install": "npm run build:catalogue",
    "prepare:content": "node --import tsx scripts/prepare-content-packs.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-notifications": "~58.1.9",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "firebase": "^13.4.0",
    "lucide-react-native": "^1.73.0",
    "markdown-it": "^15.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
