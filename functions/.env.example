# Copy to functions/.env.meiwik locally; never put an API key here.
MEIWIK_MODEL=gpt-4.1-mini
# Start private: comma-separated Firebase Authentication UID(s), not email addresses.
MEIWIK_ALLOWED_UIDS=REPLACE_WITH_YOUR_FIREBASE_UID
MEIWIK_ALLOW_ALL_AUTHENTICATED=false
MEIWIK_DAILY_REQUESTS=100
MEIWIK_DAILY_TOKEN_RESERVATIONS=500000
MEIWIK_GLOBAL_DAILY_TOKEN_RESERVATIONS=2000000
# Enable only once the mobile App Check provider has been configured and tested.
MEIWIK_ENFORCE_APP_CHECK=false
