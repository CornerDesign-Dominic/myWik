{
  "name": "mywik-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "sync-content": "node --import tsx scripts/sync-content.ts",
    "build": "npm run sync-content && tsc",
    "test": "node --import tsx --test src/core.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-mywik --config ../firebase.json \"node --import tsx --test src/rules.test.ts\"",
    "gcp-build": "",
    "serve": "npm run build && firebase emulators:start --only functions,firestore",
    "deploy": "firebase deploy --only functions:meiwik",
    "test:sync": "firebase emulators:exec --only firestore --project demo-mywik --config ../firebase.json \"node --import tsx --test ../tests/sync.integration.ts\""
  },
  "dependencies": {
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^22.0.0",
    "firebase": "^13.4.0",
    "firebase-tools": "^15.36.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
