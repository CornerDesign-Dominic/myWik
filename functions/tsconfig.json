{
  "compilerOptions": {
    "module": "commonjs", "target": "es2022", "lib": ["es2022", "dom"],
    "outDir": "lib", "rootDir": "src", "strict": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": ["src/**/*.test.ts"]
}
